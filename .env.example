# ── Site ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# WhatsApp number in E.164 WITHOUT the "+" (placeholder — replace with the real number)
NEXT_PUBLIC_WHATSAPP_NUMBER=94770000000

# ── Supabase (leave empty to run in local demo mode with a JSON file store) ─
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# ── Admin ───────────────────────────────────────────────────────────────
# Comma-separated list of emails allowed into /admin (Supabase Auth mode)
ADMIN_EMAILS=owner@example.com
# Local demo mode only: password for /admin when Supabase is not configured
ADMIN_PASSWORD=change-me
# Long random string used to sign cookies and private file links (openssl rand -hex 32)
SESSION_SECRET=

# Optional: where the local demo store writes (defaults to ./.data, or /tmp on Vercel)
# DATA_DIR=.data
